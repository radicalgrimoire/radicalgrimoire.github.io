---
import SiteTitle from '../components/SiteTitle.astro';
import SiteNavigationLink from '../components/SiteNavigationLink.astro';
import { getCollection } from 'astro:content';
import { docUrl, isCategoryIndex, sortDocs } from '../lib/docs';
import { siteConfig } from '../lib/site-config';
import { categoryColorsCss } from '../lib/site-config-schema';
import '../styles/frame.sass';
import '../styles/knowledge.sass';

interface Props {
	title: string;
	postPreview?: boolean;
}

const { title, postPreview = false } = Astro.props;
const docs = await getCollection('docs');
const categories = sortDocs(docs.filter(isCategoryIndex));
const currentDoc = docs.find((doc) => docUrl(doc).replace(/\/$/, '') === Astro.url.pathname.replace(/\/$/, ''));
---

<!DOCTYPE html>
<html lang={siteConfig.lang}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="author" content={siteConfig.author} />
		<meta name="description" content={siteConfig.description} />
		{postPreview && (
			<script is:inline>
				if (window.parent !== window && new URLSearchParams(window.location.search).get('archive_preview') === '1') {
					document.documentElement.classList.add('archive-preview');
				}
			</script>
		)}
		<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" referrerpolicy="no-referrer" />
		<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" integrity="sha384-XGjxtQfXaH2tnPFa9x+ruJTuLE3Aa6LhHSWRr1XeTyhezb4abCG4ccI5AkVDxqC+" crossorigin="anonymous" referrerpolicy="no-referrer" />
		<title>{title}</title>
		<style is:inline set:html={categoryColorsCss(siteConfig)} />
	</head>
	<body>
		<aside class="site-sidebar">
			<span class="sidebar-title"><SiteTitle /></span>
			<p class="sidebar-subtitle">{siteConfig.description}</p>
			<nav class="sidebar-nav" aria-label="Main navigation">
				{siteConfig.navigation.map((item) => 'children' in item ? (
					<>
						<span class="sidebar-nav-label">{item.title}</span>
						{item.children.map((child) => <SiteNavigationLink item={child} variant="sidebar" {categories} {docs} {currentDoc} />)}
					</>
				) : <SiteNavigationLink {item} variant="sidebar" {categories} {docs} {currentDoc} />)}
			</nav>
			<nav class="sidebar-external" aria-label="External links">
				{siteConfig.external.map((item) => (
					<a href={item.url} aria-label={item.title} title={item.title}><i class:list={['bi', `bi-${item.icon}`]} aria-hidden="true"></i></a>
				))}
			</nav>
		</aside>
		<header>
			<div class="site-brand">
				<span class="title"><SiteTitle /></span>
				<p class="site-description">{siteConfig.description}</p>
			</div>
			<nav aria-label="Main navigation">
				{siteConfig.navigation.map((item) => 'children' in item ? (
					<details class="menu-dropdown" name="mobile-navigation">
						<summary class="dropdown-toggle">{item.title}</summary>
						<ul class="dropdown-menu">
							{item.children.map((child) => (
								<li><SiteNavigationLink item={child} variant="dropdown" {categories} {docs} {currentDoc} /></li>
							))}
						</ul>
					</details>
				) : <SiteNavigationLink {item} variant="mobile" {categories} {docs} {currentDoc} />)}
				{siteConfig.external.map((item) => (
					<a href={item.url} aria-label={item.title} title={item.title}><i class:list={['bi', `bi-${item.icon}`]} aria-hidden="true"></i></a>
				))}
			</nav>
		</header>
		<main class="site-main" id="main-content">
			<slot />
		</main>
		<script is:inline defer src="/scripts/mobile-menu.js"></script>
		{postPreview && <script is:inline defer src="/scripts/archive-post-preview.js"></script>}
	</body>
</html>
