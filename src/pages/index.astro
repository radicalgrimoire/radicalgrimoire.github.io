---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { dateParts } from '../lib/dates';
import { categoryColor, postUrl } from '../lib/posts';
import { siteConfig } from '../lib/site-config';
import { contentUpdateHistory } from '../lib/update-history';
import '../styles/giants-calendar.css';

const posts = await getCollection('posts');
const history = contentUpdateHistory();
const limit = siteConfig.latest_notes_count;
const items = posts.map((post) => ({
	path: post.filePath, id: post.id, title: post.data.title, url: postUrl(post),
	type: 'Posts' as const, categories: post.data.categories, tags: post.data.tags,
})).flatMap((item) => {
	if (!item.path) throw new Error(`Missing source path for ${item.type} "${item.id}"`);
	const date = history.get(item.path.replaceAll('\\', '/'));
	if (!date) {
		console.warn(`No Git update history for ${item.path}; excluded from the home page`);
		return [];
	}
	return [{ ...item, path: item.path, date }];
}).sort((a, b) => b.date.getTime() - a.date.getTime() || a.path.localeCompare(b.path));
const recentItems = items.filter((item) => item.type === 'Posts').slice(0, limit);
---

<BaseLayout title={siteConfig.title}>
	<section class="home-list" aria-labelledby="latest-notes">
		<div class="home-heading">
			<div>
				<h1 id="latest-notes">Latest Notes</h1>
				<p class="home-intro">記事の最新{limit}件を更新順に表示しています。</p>
			</div>
		</div>
		<div class="home-tabs" role="tablist" aria-label="トップページの表示" data-home-tabs hidden>
			<button type="button" id="home-tab-articles" role="tab" aria-controls="home-panel-articles" aria-selected="true" tabindex="0" aria-label="記事" data-home-tab="articles">
				<i class="bi bi-file-text" aria-hidden="true"></i>
			</button>
			<button type="button" id="home-tab-calendar" role="tab" aria-controls="home-panel-calendar" aria-selected="false" tabindex="-1" aria-label="G-Cal" data-home-tab="calendar">
				<i class="bi bi-calendar-week" aria-hidden="true"></i>
			</button>
		</div>
		<section id="home-panel-articles" role="tabpanel" aria-labelledby="home-tab-articles" tabindex="0" data-home-panel="articles">
			<ol class="note-list" role="list" aria-label="記事の更新一覧">
				{recentItems.map((item) => {
					const parts = dateParts({ id: item.id, data: { date: item.date } }, siteConfig.timezone);
					return (
						<li class="note-item">
							<a class="note-link" href={item.url}>
								<time class="note-date" datetime={item.date.toISOString()}>
									<span>{parts.monthName}</span>
									<strong>{parts.day}</strong>
									<span>{parts.year}</span>
								</time>
								<span class="note-content">
									<span class="note-title">{item.title}</span>
									<span class="note-taxonomies">
										<span class="note-type">Posts</span>
										{item.categories.map((category) => <span class:list={['note-category', `archive-color-${categoryColor([category])}`]}>{category}</span>)}
										{item.tags.map((tag) => <span>#{tag}</span>)}
									</span>
								</span>
								<span class="note-arrow" aria-hidden="true">›</span>
							</a>
						</li>
					);
				})}
			</ol>
		</section>
		<section id="home-panel-calendar" role="tabpanel" aria-labelledby="home-tab-calendar" tabindex="0" data-home-panel="calendar" hidden>
			<div class="giants-calendar giants-calendar-compact" id="giants-calendar" data-calendar-mode="week">
				<div class="giants-calendar-toolbar">
					<div>
						<span class="giants-calendar-label">GIANTS SCHEDULE</span>
						<h2 id="giants-calendar-month"></h2>
					</div>
					<a class="giants-calendar-month-link" href="/giants-calendar/">月間カレンダー <span aria-hidden="true">›</span></a>
				</div>
				<p class="giants-calendar-status" role="status" aria-live="polite">日程を読み込んでいます…</p>
				<div class="giants-calendar-grid"></div>
				<dialog class="giants-calendar-dialog" aria-labelledby="giants-event-title">
					<div class="giants-calendar-dialog-header">
						<span class="giants-calendar-dialog-label">GAME DETAILS</span>
						<button type="button" class="giants-calendar-dialog-close" aria-label="閉じる" autofocus>×</button>
					</div>
					<h2 id="giants-event-title"></h2>
					<dl class="giants-calendar-dialog-details">
						<div>
							<dt>日時</dt>
							<dd id="giants-event-date"></dd>
						</div>
						<div id="giants-event-location-row">
							<dt>場所</dt>
							<dd id="giants-event-location"></dd>
						</div>
						<div id="giants-event-description-row">
							<dt>詳細</dt>
							<dd id="giants-event-description"></dd>
						</div>
					</dl>
					<a class="giants-calendar-add" id="giants-event-add" href="https://calendar.google.com/calendar/render" target="_blank" rel="noopener noreferrer" aria-label="Google カレンダーに追加（新しいタブで開く）" hidden>
						<i class="bi bi-calendar-plus" aria-hidden="true"></i> Google カレンダーに追加
					</a>
				</dialog>
				<noscript><p>日程の表示には JavaScript が必要です。</p></noscript>
			</div>
		</section>
	</section>
	<script is:inline defer src="/scripts/home-filters.js"></script>
	<script is:inline defer src="/scripts/giants-calendar.js"></script>
</BaseLayout>
