---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { dateParts } from '../lib/dates';
import { docUrl } from '../lib/docs';
import { categoryColor, postUrl } from '../lib/posts';
import { siteConfig } from '../lib/site-config';
import { contentUpdateHistory } from '../lib/update-history';

const [posts, docs] = await Promise.all([getCollection('posts'), getCollection('docs')]);
const history = contentUpdateHistory();
const limit = siteConfig.latest_notes_count;
const items = [
	...posts.map((post) => ({
		path: post.filePath, id: post.id, title: post.data.title, url: postUrl(post),
		type: 'Posts' as const, categories: post.data.categories, tags: post.data.tags,
	})),
	...docs.map((doc) => ({
		path: doc.filePath, id: doc.id, title: doc.data.title, url: docUrl(doc),
		type: 'Docs' as const, categories: doc.data.categories, tags: [],
	})),
].flatMap((item) => {
	if (!item.path) throw new Error(`Missing source path for ${item.type} "${item.id}"`);
	const date = history.get(item.path.replaceAll('\\', '/'));
	if (!date) {
		console.warn(`No Git update history for ${item.path}; excluded from the home page`);
		return [];
	}
	return [{ ...item, path: item.path, date }];
}).sort((a, b) => b.date.getTime() - a.date.getTime() || a.path.localeCompare(b.path));
const counts = { Posts: 0, Docs: 0 };
const recentItems = items.filter((item, index) => {
	counts[item.type]++;
	return index < limit || counts[item.type] <= limit;
});
---

<BaseLayout title={siteConfig.title}>
	<section class="home-list" aria-labelledby="latest-notes">
		<div class="home-heading">
			<div>
				<h1 id="latest-notes">Latest Notes</h1>
				<p class="home-intro">記事と資料の最新{limit}件を更新順に表示しています。</p>
			</div>
		</div>
		<div class="home-filters" role="group" aria-label="更新一覧の種類" data-home-limit={limit} data-home-filters hidden>
			<button type="button" data-home-filter="all" aria-pressed="true">すべて</button>
			<button type="button" data-home-filter="Posts" aria-pressed="false">記事</button>
			<button type="button" data-home-filter="Docs" aria-pressed="false">資料</button>
		</div>
		<p class="home-filter-status" role="status" data-home-status></p>
		<ol class="note-list" role="list" aria-label="記事と資料の更新一覧">
			{recentItems.map((item, index) => {
				const parts = dateParts({ id: item.id, data: { date: item.date } }, siteConfig.timezone);
				return (
					<li class="note-item" data-home-item={item.type} hidden={index >= limit}>
						<a class="note-link" href={item.url}>
							<time class="note-date" datetime={item.date.toISOString()}>
								<span>{parts.monthName}</span>
								<strong>{parts.day}</strong>
								<span>{parts.year}</span>
							</time>
							<span class="note-content">
								<span class="note-title">{item.title}</span>
								<span class="note-taxonomies">
									<span class="note-type">{item.type}</span>
									{item.categories.map((category) => <span class:list={['note-category', `archive-color-${categoryColor([category])}`]}>{category}</span>)}
									{item.tags.map((tag) => <span>#{tag}</span>)}
								</span>
							</span>
							<span class="note-arrow" aria-hidden="true">›</span>
						</a>
					</li>
				);
			})}
		</ol>
	</section>
	<script is:inline defer src="/scripts/home-filters.js"></script>
</BaseLayout>
